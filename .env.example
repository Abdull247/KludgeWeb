# Public API origin used by the browser for OAuth and JSON calls.
# Local:
# NEXT_PUBLIC_API_URL=http://localhost:8080
# Live:
NEXT_PUBLIC_API_URL=https://kludgeserver.onrender.com

# Public site origin sent as the OAuth next URL.
# NEXT_PUBLIC_SITE_URL=https://kludgekit.web.app

# Optional. When set, every API call sends Authorization: Bearer <token>.
# Pair with MODE=test on the Go server to drive catalog mocks without OAuth.
# NEXT_PUBLIC_TEST_TOKEN=test
