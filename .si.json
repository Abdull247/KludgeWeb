{
  "plugin": "org.smartide.plugin.framework.javascript.nextjs",
  "run": "npm install && npx next dev --webpack",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".tsx": {
      "enabled": true,
      "run": "typescript-language-server --stdio"
    },
    ".md": {
      "enabled": true,
      "run": "marksman server"
    },
    ".svg": {
      "enabled": true,
      "run": "lemminx"
    },
    ".ts": {
      "enabled": true,
      "run": "typescript-language-server --stdio"
    },
    ".css": {
      "enabled": true,
      "run": "vscode-css-language-server --stdio"
    },
    ".html": {
      "enabled": true,
      "run": "vscode-html-language-server --stdio"
    }
  }
}